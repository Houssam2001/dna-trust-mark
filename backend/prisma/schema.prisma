generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums matched from Supabase
enum AppRole {
  admin
  //agent
  //owner
}

enum CertificationStatus {
  conforme
  non_conforme
  en_attente
  suspendu
  n_existe_plus
}

enum EstablishmentType {
  boucherie
  restaurant
  usine
  traiteur
  autre
}

// Models

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   // New field for hashed password
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  // Relations
  profile   Profile?
  roles     UserRole[]
  controls  Control[] // Agent performing controls

  @@map("users") // Although Supabase manages users in auth.users, we now need a dedicated table or use this one
}

model Profile {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  fullName  String?  @map("full_name")
  email     String?
  phone     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  role      AppRole
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_roles")
}

model Establishment {
  id              String             @id @default(uuid())
  name            String
  type            EstablishmentType?
  address         String
  city            String
  postalCode      String?            @map("postal_code")
  phone           String?
  email           String?
  siret           String?
  adnguardCode    String?            @map("adnguard_code")
  status          CertificationStatus @default(en_attente)
  ownerId         String?            @map("owner_id")
  certifiedSince  DateTime?          @map("certified_since")
  lastControlDate DateTime?          @map("last_control_date")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  // Relations
  certifications  Certification[]
  controls        Control[]
  qrVerifications QrVerification[]

  @@map("establishments")
}

model Control {
  id                String             @id @default(uuid())
  establishmentId   String             @map("establishment_id")
  agentId           String?            @map("agent_id")
  result            CertificationStatus
  speciesAnalyzed   String[]           @map("species_analyzed")
  speciesDetected   String[]           @map("species_detected")
  anomaliesDetected String?            @map("anomalies_detected")
  notes             String?
  controlDate       DateTime           @default(now()) @map("control_date")
  reportUrl         String?            @map("report_url")
  reportId          String?            @map("report_id")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  agent         User?         @relation(fields: [agentId], references: [id])

  @@map("controls")
}

model Certification {
  id              String   @id @default(uuid())
  establishmentId String   @map("establishment_id")
  validFrom       DateTime @map("valid_from")
  validUntil      DateTime @map("valid_until")
  qrCode          String   @map("qr_code")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@map("certifications")
}

model QrVerification {
  id              String   @id @default(uuid())
  establishmentId String   @map("establishment_id")
  ipAddress       String?  @map("ip_address")
  userAgent       String?  @map("user_agent")
  verifiedAt      DateTime @default(now()) @map("verified_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@map("qr_verifications")
}
